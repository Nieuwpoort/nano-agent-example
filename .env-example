# ifenpay Agent - Stateless LLM Baseline
# Used by Docker Compose and optional local runs

# Server
HOST=0.0.0.0
PORT=7860

# Agent behavior
AGENT_MODE=hybrid

# LLM
LLM_MODEL=mistral:7b
LLM_HOST=http://ollama:11434
LLM_USE_GPU=true
LLM_PRELOAD_MODEL=true
LLM_CONTEXT_LENGTH=2048
LLM_FLASH_ATTENTION=true
LLM_KEEP_ALIVE=30m
LLM_NUM_PARALLEL=4

# Ollama container
OLLAMA_FLASH_ATTENTION=true
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=2048

# MCP plug-and-play (connect-only)
# Agent does NOT start a server; it connects to an already running plugin toolset API.
MCP_TOOLSET_BASE_URL=http://host.docker.internal:3123

